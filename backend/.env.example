# Copied to .env by scripts/setup.sh, which also fills in JARVIS_TOKEN.
# .env is gitignored; never commit real values.

# Shared secret between the core and the HUD (WebSocket) and for the local MCP tool server.
JARVIS_TOKEN=

# Phase 5 (paid fallback) only. JARVIS never passes this to the Claude CLI,
# so the subscription provider can't bill it by accident.
# ANTHROPIC_API_KEY=
