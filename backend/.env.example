# Copied to .env by scripts/setup.sh, which also fills in JARVIS_TOKEN.
# .env is gitignored; never commit real values.

# Shared secret between the core and the HUD (WebSocket) and for the local MCP tool server.
JARVIS_TOKEN=

# Paid fallback only (the last provider in the chain, capped monthly in config.toml).
# JARVIS never passes it to the Claude or Codex CLIs, so the plans can't bill it by accident.
# ANTHROPIC_API_KEY=
